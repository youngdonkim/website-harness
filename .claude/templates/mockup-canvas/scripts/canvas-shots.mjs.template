// 목업 캔버스 그림 찍기 — 캔버스가 멀리서 보여 줄 미리보기 그림을 찍어 `.canvas-shots/`에 둔다(git에 안 올린다).
// 사람이 캔버스를 훑어볼 때 쓰는 그림이다. AI가 화면이 맞는지 판정하는 수단이 아니다 — 화면 판정은 사람 몫이다.
//
// 쓰는 법 (개발 서버를 먼저 띄워 둔다 — 실서비스 빌드를 MOCKUP_CANVAS=1로 띄운 서버여도 된다):
//   npm run canvas:shots                          # http://localhost:3000 의 모든 창
//   npm run canvas:shots -- http://localhost:3001 # 다른 주소
//   npm run canvas:shots -- S-01 S-02             # 그 화면만 다시 찍기
// package.json의 canvas:shots는 먼저 `playwright install --only-shell chromium`을 돌린다 — 첫 실행 때만 브라우저를 내려받고, 그 뒤엔 바로 넘어간다.
//
// 찍을 창 목록은 서버의 /dev/canvas/frames에서 받는다(screens.ts를 창 목록으로 편 것). 그림 이름은 `<창 열쇠>.jpg`.

import { mkdir, readdir, rm } from "node:fs/promises"
import path from "node:path"
import { chromium } from "playwright"

const args = process.argv.slice(2)
const base = (args.find((a) => /^https?:\/\//.test(a)) ?? process.env.CANVAS_URL ?? "http://localhost:3000").replace(/\/$/, "")
const only = new Set(args.filter((a) => !/^https?:\/\//.test(a)))
const outDir = path.join(process.cwd(), ".canvas-shots")
// 그림 배율 — 창의 절반 크기로 찍는다. 멀리서 보는 그림이라 이걸로 충분하고, 가까이 가면 실제 창으로 바뀐다
const SCALE = 0.5
// 동시에 여는 창 수 — 개발 서버는 처음 여는 주소를 그때 만들어서, 많이 열면 오히려 느려진다
const CONCURRENCY = 2

const response = await fetch(`${base}/dev/canvas/frames`).catch(() => null)
if (!response?.ok) {
  console.error(`창 목록을 못 받았습니다: ${base}/dev/canvas/frames — 개발 서버가 떠 있는지, 주소가 맞는지 확인하세요.`)
  process.exit(1)
}
const { frames, viewports } = await response.json()
const targets = only.size ? frames.filter((f) => only.has(f.screenId)) : frames
await mkdir(outDir, { recursive: true })

const browser = await chromium.launch()
const contexts = {}
for (const [name, size] of Object.entries(viewports)) {
  contexts[name] = await browser.newContext({
    viewport: { width: size.width, height: size.height },
    deviceScaleFactor: SCALE,
    isMobile: name === "phone",
    hasTouch: name === "phone",
  })
  // 개발 도구 표시(Next.js 개발 표시·요소 복사 도구)는 그림에 넣지 않는다
  await contexts[name].addInitScript(() => {
    window.__REACT_GRAB_DISABLED__ = true
    const hide = () => {
      const style = document.createElement("style")
      style.textContent = "nextjs-portal{display:none !important}"
      document.head.appendChild(style)
    }
    if (document.head) hide()
    else document.addEventListener("DOMContentLoaded", hide)
  })
}

let done = 0
let failed = 0
const queue = [...targets]
async function worker() {
  for (let frame = queue.shift(); frame; frame = queue.shift()) {
    const page = await contexts[frame.viewport].newPage()
    try {
      await page.goto(`${base}${frame.url}`, { waitUntil: "load", timeout: 90_000 })
      // 로딩 상태는 뼈대가 보이는 동안 찍고, 나머지는 화면이 자리 잡을 때까지 조금 기다린다
      if (frame.state === "loading") await page.waitForTimeout(800)
      else {
        await page.waitForLoadState("networkidle", { timeout: 10_000 }).catch(() => {})
        await page.waitForTimeout(500)
      }
      await page.screenshot({ path: path.join(outDir, `${frame.key}.jpg`), type: "jpeg", quality: 70 })
      done += 1
      console.log(`[${done + failed}/${targets.length}] ${frame.screenId} ${frame.viewport} ${frame.state ?? ""} ${frame.draft ?? ""}`)
    } catch (error) {
      failed += 1
      console.error(`[${done + failed}/${targets.length}] 실패 ${frame.key}: ${error.message.split("\n")[0]}`)
    } finally {
      await page.close()
    }
  }
}
await Promise.all(Array.from({ length: CONCURRENCY }, worker))
await browser.close()

// 목록에서 빠진 창의 옛 그림을 지운다(전체를 찍었을 때만)
if (!only.size) {
  const keep = new Set(frames.map((f) => `${f.key}.jpg`))
  for (const name of await readdir(outDir)) if (name.endsWith(".jpg") && !keep.has(name)) await rm(path.join(outDir, name))
}
console.log(`그림 ${done}장을 ${path.relative(process.cwd(), outDir)}/에 두었습니다.${failed ? ` 실패 ${failed}장.` : ""}`)
process.exit(failed ? 1 : 0)
