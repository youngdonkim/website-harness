// 상태 표 채우기 — mvp/feature-list.md의 7절(상태 표)에서, 화면 ID마다 받은 상태 값을 해당 칸 끝 괄호 (?state=…)로 적어 넣는다.
// 칸 번호를 손으로 세다 한 칸 밀려 적는 일을 막으려는 것이다 — 칸은 머리줄의 이름으로 찾는다.
//   빈 상태 → empty · 로딩 → loading · 오류 → error · 권한없음 → forbidden
//
// 쓰는 법 (프로젝트 맨 위에서):
//   node scripts/state-fill.mjs 상태값.txt     # 입력 파일을 읽어 상태 표에 적는다
//   node scripts/state-fill.mjs --check        # 적지 않고 점검만: O인데 값이 없는 칸, 값이 있는데 O가 아닌 칸
// 입력 파일은 한 줄에 화면 하나 — 「화면 ID 상태 값들」. 쉼표·공백으로 나눈다. # 으로 시작하는 줄은 건너뛴다. 예:
//   S-01 empty loading
//   S-02: error forbidden
//
// 적는 규칙 — 그 칸이 `O`로 시작할 때만 적는다. `해당없음`이나 `O*`(단추를 눌러야 생기는 상태)인 칸은 건드리지 않고 알려 준다.
//   한 칸에 ` · `로 이은 글이 있으면 첫 `O` 덩어리 끝에 붙인다. 이미 (?state=…)가 있으면 건너뛴다.
// 끝나면 npm run canvas:list를 다시 돌린다.

import { readFile, writeFile } from "node:fs/promises"
import path from "node:path"

const SOURCE = path.join(process.cwd(), "mvp", "feature-list.md")
const COLUMNS = { "빈 상태": "empty", 로딩: "loading", 오류: "error", 권한없음: "forbidden" }

const arg = process.argv[2]
const checkOnly = arg === "--check"
if (!arg) {
  console.error("쓰는 법: node scripts/state-fill.mjs <상태값 파일>   (또는 --check)")
  process.exit(1)
}

const text = await readFile(SOURCE, "utf8").catch(() => null)
if (text === null) {
  console.error(`화면 목록 문서가 없습니다: ${path.relative(process.cwd(), SOURCE)}`)
  process.exit(1)
}

// 입력: 화면 ID → 상태 값 목록
const wanted = new Map()
if (!checkOnly) {
  const input = await readFile(arg, "utf8").catch(() => null)
  if (input === null) {
    console.error(`입력 파일을 읽지 못했습니다: ${arg}`)
    process.exit(1)
  }
  for (const raw of input.split("\n")) {
    const line = raw.trim()
    if (!line || line.startsWith("#")) continue
    const [id, ...rest] = line.split(/[\s,:]+/).filter(Boolean)
    const values = rest.filter((v) => Object.values(COLUMNS).includes(v))
    const unknown = rest.filter((v) => !Object.values(COLUMNS).includes(v))
    if (unknown.length) console.warn(`모르는 상태 값은 건너뜁니다 (${id}): ${unknown.join(", ")}`)
    wanted.set(id, [...(wanted.get(id) ?? []), ...values])
  }
}

const lines = text.split("\n")
const start = lines.findIndex((l) => /^##\s+7\./.test(l))
if (start < 0) {
  console.error("7절 상태 표를 찾지 못했습니다(「## 7.」 아래 첫 표).")
  process.exit(1)
}
const cellsOf = (line) => line.replace(/^\||\|$/g, "").split("|").map((c) => c.trim())
let head = null
const seen = new Set()
const notes = []
let changed = 0

for (let i = start + 1; i < lines.length && !/^##\s/.test(lines[i]); i++) {
  const line = lines[i].trim()
  if (!line.startsWith("|")) {
    if (head) break
    continue
  }
  const cells = cellsOf(line)
  if (!head) {
    head = cells
    continue
  }
  if (/^[-:\s]+$/.test(cells.join(""))) continue
  const id = cells[0]?.match(/^S-[0-9A-Za-z-]+/)?.[0]
  if (!id) continue
  seen.add(id)
  const asked = wanted.get(id) ?? []
  let rowChanged = false
  for (const [name, value] of Object.entries(COLUMNS)) {
    const c = head.indexOf(name)
    if (c < 0) continue
    const cell = cells[c] ?? ""
    const has = cell.includes(`?state=${value}`)
    const isO = /^O(?!\*)/.test(cell)
    if (checkOnly) {
      if (isO && !/\?state=/.test(cell)) notes.push(`${id} ${name}: O인데 (?state=${value}) 값이 없습니다`)
      if (!isO && /\?state=/.test(cell)) notes.push(`${id} ${name}: O가 아닌데 ?state= 값이 있습니다`)
      continue
    }
    if (!asked.includes(value) || has) continue
    if (!isO) {
      notes.push(`${id} ${name}: 칸이 「${cell || "빈 칸"}」이라 적지 않았습니다 (O 칸에만 적습니다)`)
      continue
    }
    const parts = cell.split(" · ")
    parts[0] = `${parts[0]} (?state=${value})`
    cells[c] = parts.join(" · ")
    rowChanged = true
    changed++
  }
  if (rowChanged) lines[i] = `| ${cells.join(" | ")} |`
}

for (const id of wanted.keys()) if (!seen.has(id)) notes.push(`${id}: 상태 표에 이 화면 행이 없습니다`)

if (!checkOnly && changed) await writeFile(SOURCE, lines.join("\n"))
if (checkOnly) {
  if (!notes.length) console.log("점검 통과 — O 칸마다 값이 있습니다.")
} else console.log(`${changed}칸을 적었습니다.`)
for (const n of notes) console.log(`- ${n}`)
if (!checkOnly && changed) console.log("이어서 npm run canvas:list를 돌리세요.")
