// {{프로젝트에 없는 부품은 import와 아래 「부품 상태」 칸에서 같이 지운다. 있는 부품(탭·토글 등)은 같은 모양으로 더한다}}

// 디자인 시스템 페이지 — 실제 토큰과 실제 부품으로 그린다. 토큰의 정본은 1·2층 CSS이고, 이 페이지는 그것을 비춰 보여 주는 거울이다.
// 색·크기 값은 코드에 적지 않고, 브라우저가 계산한 값을 읽어 보여 준다.
// 프로젝트마다 고칠 자리: `{{…}}`와 「프로젝트에 맞게 고친다」 주석.
// 맨 바깥은 <div>다 — 셸(루트 레이아웃)이 본문 영역에 <main>을 두는 구조가 기본이라 겹치지 않게 한다.
// 셸이 <main>을 두지 않고 화면마다 두는 프로젝트면 맨 바깥 <div>를 <main>으로 바꾼다(한 페이지에 <main>은 하나).
// 이 페이지의 견본은 강조색(primary)을 쓰는 자리 규칙을 지킨다 — 강조색은 주 버튼 견본과 색 역할 견본에만, 막대·칸 견본은 무채색.

const SERVICE_NAME = "{{서비스 이름}}"

/** 견본 하나 — 클래스를 입힌 상자를 그리고, 브라우저가 계산한 값을 읽어 옆에 보여 준다 */
function Probe({
  className,
  read,
  children,
}: {
  className: string
  read: (keyof CSSStyleDeclaration & string)[]
  children?: React.ReactNode
}) {
  const ref = useRef<HTMLDivElement>(null)
  const [values, setValues] = useState<string[]>([])
  useEffect(() => {
    if (!ref.current) return
    const style = getComputedStyle(ref.current)
    setValues(read.map((key) => String(style[key])))
  }, [read])
  return (
    <div className="flex flex-col gap-1">
      <div ref={ref} className={className}>
        {children}
      </div>
      <p className="text-b2 text-muted-foreground">{values.join(" · ")}</p>
    </div>
  )
}

function Section({ title, children }: { title: string; children: React.ReactNode }) {
  return (
    <section className="flex flex-col gap-6">
      <h2 className="border-b border-border pb-2 text-h2">{title}</h2>
      {children}
    </section>
  )
}

