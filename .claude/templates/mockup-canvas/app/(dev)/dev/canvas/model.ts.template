import type { CanvasScreen } from "./screens"

// 목업 캔버스의 「창」 목록과 코멘트 모양 — 캔버스 화면(canvas-board.tsx)·창 목록 라우트(frames/route.ts)·
// 코멘트 라우트(comments/route.ts)·그림 찍기 스크립트(scripts/canvas-shots.mjs, 창 목록 라우트로 받는다)가 같은 정의를 쓴다.
// 창 하나 = 화면 하나 × 폭 하나(데스크톱·폰 — 화면의 widths가 ["phone"]이면 폰만) × 상태 하나(기본·?state=…) × 판 하나(원래 화면·비교안).

export type Viewport = NonNullable<CanvasScreen["widths"]>[number]
/** 폭 차례 — 한 줄 안에서 데스크톱 창이 왼쪽, 폰 창이 오른쪽 */
export const VIEWPORT_ORDER: Viewport[] = ["desktop", "phone"]
/** 상태 이름 — screens.ts의 states에 적는 값 */
export type CanvasState = NonNullable<CanvasScreen["states"]>[number]

/** 창 크기 — 데스크톱은 실제 폭으로 띄워 창 안의 컨테이너 쿼리가 실제 폭 기준으로 돈다 */
export const VIEWPORTS: Record<Viewport, { width: number; height: number; label: string }> = {
  desktop: { width: 1440, height: 900, label: "데스크톱" },
  phone: { width: 390, height: 844, label: "폰" },
}

export type CanvasFrame = {
  /** 창 열쇠 — 그림 파일 이름(`<key>.jpg`)이기도 하다. 영문·숫자·-·_만 쓴다 */
  key: string
  screenId: string
  screenName: string
  group: string
  /** 비교안이면 판 이름, 원래 화면이면 null */
  draft: string | null
  viewport: Viewport
  /** 기본 모양이면 null */
  state: CanvasState | null
  /** 창이 여는 주소 (?state= 포함) */
  url: string
  /** 캔버스에서 같은 줄에 놓이는 창끼리 같은 값 — 기본·상태·비교안마다 한 줄 */
  row: number
}

export function withState(path: string, state: string) {
  return `${path}${path.includes("?") ? "&" : "?"}state=${state}`
}

function slug(text: string) {
  return text.replace(/[^A-Za-z0-9]+/g, "-").replace(/^-|-$/g, "") || "root"
}

/** screens.ts 목록을 창 목록으로 편다 — 배열 순서가 곧 캔버스 순서다 */
export function buildFrames(screens: CanvasScreen[]): CanvasFrame[] {
  const frames: CanvasFrame[] = []
  for (const screen of screens) {
    let row = 0
    // 띄울 폭 — 안 적었거나 비었으면 둘 다
    const widths = VIEWPORT_ORDER.filter((viewport) => !screen.widths?.length || screen.widths.includes(viewport))
    const add = (draft: { label: string; path: string } | null, states: CanvasState[]) => {
      const path = draft ? draft.path : screen.path
      const variant = draft ? `draft-${slug(draft.path)}` : "main"
      for (const state of [null, ...states]) {
        for (const viewport of widths) {
          frames.push({
            key: `${slug(screen.id)}__${variant}__${viewport}__${state ?? "base"}`,
            screenId: screen.id,
            screenName: screen.name,
            group: screen.group,
            draft: draft ? draft.label : null,
            viewport,
            state,
            url: state ? withState(path, state) : path,
            row,
          })
        }
        row += 1
      }
    }
    add(null, screen.states ?? [])
    // 비교안의 상태 창 — 따로 적지 않으면 원래 화면과 같은 상태를 띄운다(비교안도 같은 저장·조회 코드를 거친다)
    // (판의 states 필드가 없는 목록 파일도 그대로 읽는다)
    for (const draft of (screen.drafts ?? []) as { label: string; path: string; states?: CanvasState[] }[]) {
      add(draft, draft.states ?? screen.states ?? [])
    }
  }
  return frames
}

/** 코멘트 한 건 — mvp/canvas-comments.json에 배열로 쌓인다(사람이 남긴 수정 요청 기록, git에 올라간다) */
export type CanvasComment = {
  id: string
  screenId: string
  screenName: string
  /** 비교안에 단 코멘트면 판 이름 */
  draft: string | null
  /** 창이 연 주소 (?state= 포함) — 같은 주소·같은 폭의 창을 다시 띄우면 핀이 다시 보인다 */
  url: string
  viewport: Viewport
  state: CanvasState | null
  /** 요소를 다시 찾을 단서 */
  target: {
    /** CSS 선택자 */
    selector: string
    /** 요소 글자 앞부분 */
    text: string
    /** 코드 자리 「파일:줄」 — 개발 서버에서 요소 복사 도구가 알려 줄 때만 */
    source: string | null
    /** 부품 이름 — 같은 조건 */
    component: string | null
  }
  /** 화면(문서) 안 위치 — 문서 왼쪽 위에서 잰 거리, 그리고 요소 상자 안의 비율(0~1) */
  position: { x: number; y: number; rx: number; ry: number }
  comment: string
  status: "open" | "done"
  /** 처리 메모 — 고친 쪽(대개 Claude)이 무엇을 고쳤는지 적는다 */
  resolution: string
  createdAt: string
  resolvedAt: string | null
}
