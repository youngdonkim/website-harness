import { notFound } from "next/navigation"

// 개발용 묶음 — 목업 캔버스·디자인 시스템 페이지·비교안이 이 아래에 산다.
// 실서비스 빌드(`next build` 뒤 `next start`, Vercel 배포)에서는 이 묶음의 모든 주소가 404다.
// 예외 하나 — 내 컴퓨터에서 실서비스 빌드로 빠르게 훑어볼 때만 `MOCKUP_CANVAS=1`을 빌드와 실행 명령 앞에 붙여 연다.
//   MOCKUP_CANVAS=1 npm run build && MOCKUP_CANVAS=1 npm run start
// 이 페이지들은 빌드 때 미리 그려 두기 때문에 빌드 때 이 변수가 있었는지로 열림이 정해진다.
// 그래서 Vercel 환경변수에는 이 변수를 절대 넣지 않는다 — 넣으면 공개 주소에서 열린다.
export default function DevLayout({ children }: { children: React.ReactNode }) {
  if (process.env.NODE_ENV === "production" && process.env.MOCKUP_CANVAS !== "1") notFound()
  return <>{children}</>
}
