// 목업 캔버스가 화면의 상태(빈·로딩·오류·권한없음)를 띄울 때 쓰는 도우미.
// 개발 서버에서만 주소 끝 `?state=empty|loading|error|forbidden`을 읽는다. 실서비스 빌드에서는 늘 null이다.
// 예외는 `(dev)/layout.tsx`와 같다 — 내 컴퓨터에서 `MOCKUP_CANVAS=1`을 붙여 빌드한 실서비스에서만 읽는다(Vercel에는 넣지 않는다).
// 이 함수는 브라우저에서도 돈다(데이터를 브라우저에서 읽는 저장·조회 코드가 부를 때). 브라우저 코드는 서버 환경변수를 못 읽으므로,
// next.config.ts의 `env`가 빌드 때 MOCKUP_CANVAS 값을 글자 그대로 코드에 넣어 둔다(없으면 빈 글자) — README 「프로젝트에 넣는 차례」.
// 그래서 서버와 브라우저가 같은 조건으로 켜지고, 변수 없이 빌드한 실서비스에서는 둘 다 꺼진 채다.
//
// 화면 코드는 고치지 않는다. 저장·조회 코드(서버 컴포넌트·서버 함수, 또는 브라우저에서 데이터를 읽는 코드)가 이 함수를 불러 상태를 흉내 낸다.
// 상태 표시는 주소로만 정한다(브라우저 저장소에 쓰지 않는다) — 한 창이 다른 창의 상태를 바꾸지 않게 하려는 것이다.
//
// 부르는 예 (저장·조회 코드, 페이지의 searchParams를 그대로 넘긴다):
//
//   export default async function Page({ searchParams }: { searchParams: Promise<DevSearchParams> }) {
//     const state = await readDevState(searchParams)
//     if (state === "loading") await devLoadingDelay()      // 느린 응답 흉내
//     if (state === "error") throw new Error("개발용 오류")   // 오류 흉내 (error.tsx가 받는다)
//     if (state === "forbidden") redirect("/login")          // 권한없음 흉내 (또는 forbidden 화면)
//     const items = state === "empty" ? [] : await listItems() // 빈 결과 흉내
//     ...
//   }

export const DEV_STATES = ["empty", "loading", "error", "forbidden"] as const
export type DevState = (typeof DEV_STATES)[number]
export type DevSearchParams = Record<string, string | string[] | undefined>

export async function readDevState(
  searchParams?: DevSearchParams | Promise<DevSearchParams>,
): Promise<DevState | null> {
  if (process.env.NODE_ENV === "production" && process.env.MOCKUP_CANVAS !== "1") return null
  const params = await searchParams
  const raw = params?.state
  const value = Array.isArray(raw) ? raw[0] : raw
  return DEV_STATES.find((s) => s === value) ?? null
}

/** 느린 응답 흉내 — 로딩 화면이 보일 만큼 기다린다. 숫자는 밀리초다. */
export function devLoadingDelay(ms = 4000): Promise<void> {
  return new Promise((resolve) => setTimeout(resolve, ms))
}
