// 개발용 라우트 핸들러(route.ts)의 문지기 — `(dev)/layout.tsx`의 막기는 페이지에만 듣고 라우트 핸들러에는 안 듣는다.
// 그래서 이 묶음의 route.ts는 맨 앞에서 이 함수를 불러, 실서비스 빌드면 404를 돌려준다.
// 열림 조건은 레이아웃과 같다 — 개발 서버, 또는 내 컴퓨터에서 `MOCKUP_CANVAS=1`을 붙여 빌드한 실서비스.
export function devOnly(): Response | null {
  if (process.env.NODE_ENV === "production" && process.env.MOCKUP_CANVAS !== "1") {
    return new Response("Not Found", { status: 404 })
  }
  return null
}
