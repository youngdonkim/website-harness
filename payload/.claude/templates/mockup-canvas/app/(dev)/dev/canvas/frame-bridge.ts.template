import type { CanvasComment } from "./model"

// 캔버스가 창(iframe) 안 문서에 거는 장치 — 창은 같은 주소(같은 출처)라 캔버스가 창 문서에 이벤트를 걸고 핀을 꽂을 수 있다.
// 거는 것: 코멘트 모드의 클릭(또는 지름길 Alt/Option+클릭) → 코멘트 자리 알리기 · 핀 그리기와 핀 누르기 ·
// 키(Esc·C·Space)를 캔버스로 넘기기 · 휠(캔버스 위의 창이면 캔버스 확대·이동으로 넘기기).
// 화면 코드는 고치지 않는다. 핀은 창 문서 맨 끝에 따로 붙인 상자 안에 그린다.

/** 요소 복사 도구(React Grab)가 창 문서에 올려 두는 전역 API 중 여기서 쓰는 것 — 개발 서버에서만 있다 */
type ReactGrabLike = {
  getSource?: (element: Element) => Promise<{
    filePath: string
    lineNumber: number | null
    componentName: string | null
  } | null>
}

export type CommentClickInfo = {
  /** 창이 지금 보여 주는 주소 — 창 안에서 링크를 눌러 다른 화면으로 옮겨 갔을 수 있어 창의 처음 주소 대신 이것을 쓴다 */
  url: string
  /** 창 안에서 누른 자리(창 왼쪽 위 기준, 창의 실제 크기 단위) */
  clientX: number
  clientY: number
  target: CanvasComment["target"]
  position: CanvasComment["position"]
}

export type FrameBridgeHandlers = {
  /** 코멘트 모드에서 클릭(또는 Alt/Option+클릭)한 자리 */
  onCommentClick: (info: CommentClickInfo) => void
  onPinClick: (id: string) => void
  onEscape: () => void
  /** C — 코멘트 모드 켜고 끄기 */
  onToggleComment: () => void
  /** Space를 누르고 있는 동안 — 캔버스 끌기 */
  onSpace: (down: boolean) => void
  /** 휠·트랙패드 — 주면 창 안 화면을 굴리지 않고 이 함수로 넘긴다(캔버스 위의 창). 크게 보기 창에는 주지 않는다 */
  onWheel?: (event: WheelEvent) => void
}

export type PinItem = { comment: CanvasComment; number: number }

export type FrameBridge = {
  /** 이 창 폭의 코멘트와 핀 번호(코멘트 목록의 번호)를 넘긴다 — 지금 주소와 같은 것만 핀으로 그린다 */
  setPins: (pins: PinItem[]) => void
  /** 코멘트 모드 — 켜면 마우스 모양이 십자로 바뀌고, 그냥 클릭해도 코멘트 자리로 받는다 */
  setCommentMode: (on: boolean) => void
  detach: () => void
}

const PIN_LAYER = "data-canvas-pins"
const CURSOR_STYLE = "data-canvas-comment-cursor"

/** 글을 적는 칸에서 누른 키는 화면 몫이다 */
function isEditable(target: EventTarget | null) {
  const node = target as Element | null
  return Boolean(node?.closest?.('input, textarea, select, [contenteditable=""], [contenteditable="true"]'))
}

/** 요소를 다시 찾을 CSS 선택자 — id가 있으면 그것, 없으면 몸통(body)까지 태그·차례로 잇는다 */
function selectorOf(element: Element): string {
  const parts: string[] = []
  let node: Element | null = element
  while (node && node.tagName !== "BODY" && node.tagName !== "HTML" && parts.length < 8) {
    if (node.id && !/^(radix-|:r)/.test(node.id)) {
      parts.unshift(`#${CSS.escape(node.id)}`)
      break
    }
    const tag = node.tagName.toLowerCase()
    const parent: Element | null = node.parentElement
    const same = parent ? Array.from(parent.children).filter((c) => c.tagName === node!.tagName) : []
    parts.unshift(same.length > 1 ? `${tag}:nth-of-type(${same.indexOf(node) + 1})` : tag)
    node = parent
  }
  return parts.join(" > ")
}

function textOf(element: Element) {
  return (element.textContent ?? "").replace(/\s+/g, " ").trim().slice(0, 80)
}

async function sourceOf(win: Window, element: Element) {
  const grab = (win as Window & { __REACT_GRAB__?: ReactGrabLike }).__REACT_GRAB__
  try {
    const info = await grab?.getSource?.(element)
    if (!info) return { source: null, component: null }
    // 도구가 주는 경로는 컴퓨터 전체 경로일 때가 있다 — 프로젝트 안 경로(src/…)로 줄인다
    const at = info.filePath.indexOf("/src/")
    const file = at >= 0 ? info.filePath.slice(at + 1) : info.filePath
    return {
      source: info.lineNumber ? `${file}:${info.lineNumber}` : file,
      component: info.componentName,
    }
  } catch {
    return { source: null, component: null }
  }
}

/** 핀이 놓일 문서 좌표 — 요소를 다시 찾으면 요소 상자 안 비율로, 못 찾으면 저장한 문서 좌표로 */
function pinPoint(doc: Document, comment: CanvasComment) {
  const win = doc.defaultView
  let element: Element | null = null
  try {
    element = comment.target.selector ? doc.querySelector(comment.target.selector) : null
  } catch {
    element = null
  }
  if (element && win && (!comment.target.text || textOf(element).startsWith(comment.target.text.slice(0, 20)))) {
    const rect = element.getBoundingClientRect()
    if (rect.width > 0 || rect.height > 0) {
      return {
        x: rect.left + win.scrollX + rect.width * comment.position.rx,
        y: rect.top + win.scrollY + rect.height * comment.position.ry,
      }
    }
  }
  return { x: comment.position.x, y: comment.position.y }
}

export function attachFrameBridge(iframe: HTMLIFrameElement, handlers: FrameBridgeHandlers): FrameBridge | null {
  const win = iframe.contentWindow
  const doc = iframe.contentDocument
  if (!win || !doc || !doc.body) return null

  // 핀 상자 — 문서 맨 위 왼쪽에 크기 0으로 붙이고, 핀은 문서 좌표로 놓는다(화면을 내리면 핀도 같이 움직인다).
  // 요소 복사 도구가 핀을 고르지 않게 data-react-grab-ignore를 단다.
  const layer = doc.createElement("div")
  layer.setAttribute(PIN_LAYER, "")
  layer.setAttribute("data-react-grab-ignore", "")
  Object.assign(layer.style, { position: "absolute", left: "0", top: "0", width: "0", height: "0", zIndex: "2147483647" })
  doc.body.appendChild(layer)

  // 창 안에서 링크를 누르면 문서는 그대로 두고 주소만 바뀐다(앱 안 이동) — 핀은 지금 주소의 코멘트만 그린다
  const here = () => win.location.pathname + win.location.search
  const sameUrl = (url: string) => {
    try {
      const u = new URL(url, win.location.href)
      return u.pathname + u.search === here()
    } catch {
      return false
    }
  }
  let pins: PinItem[] = []
  const draw = () => {
    layer.replaceChildren(
      ...pins.filter(({ comment }) => sameUrl(comment.url)).map(({ comment, number }) => {
        const point = pinPoint(doc, comment)
        const pin = doc.createElement("button")
        pin.type = "button"
        pin.title = comment.comment
        pin.textContent = String(number)
        pin.dataset.commentId = comment.id
        // 색은 앱의 2층 이름(var)으로 — 숫자 색 값을 적지 않는다
        Object.assign(pin.style, {
          position: "absolute",
          left: `calc(${point.x / 16}rem - 0.875rem)`,
          top: `calc(${point.y / 16}rem - 0.875rem)`,
          width: "1.75rem",
          height: "1.75rem",
          borderRadius: "9999rem",
          border: "0.125rem solid var(--background)",
          background: "var(--foreground)",
          color: "var(--background)",
          font: "600 0.875rem/1 system-ui, sans-serif",
          cursor: "pointer",
          boxShadow: "0 0 0 0.0625rem var(--foreground)",
        })
        return pin
      }),
    )
  }
  const timer = win.setInterval(draw, 1000) // 화면이 바뀌어도(불러오기·접기) 핀이 요소를 따라가게 가끔 다시 놓는다

  let commentMode = false
  // 코멘트 모드의 누르기(또는 Alt/Option+누르기) — 화면의 원래 동작(링크 이동·메뉴 열기·내려받기)보다 먼저 가로챈다
  const swallow = (event: Event) => {
    const e = event as MouseEvent
    if (!e.altKey && !commentMode) return
    if ((e.target as Element | null)?.closest?.(`[${PIN_LAYER}]`)) return
    e.preventDefault()
    e.stopImmediatePropagation()
  }
  const onClick = async (event: MouseEvent) => {
    const pinButton = (event.target as Element | null)?.closest?.(`[${PIN_LAYER}] button`) as HTMLElement | null
    if (pinButton?.dataset.commentId) {
      event.preventDefault()
      event.stopImmediatePropagation()
      handlers.onPinClick(pinButton.dataset.commentId)
      return
    }
    if (!event.altKey && !commentMode) return
    event.preventDefault()
    event.stopImmediatePropagation()
    const picked = event.target as Node | null
    const element = picked && picked.nodeType === 1 ? (picked as Element) : doc.body
    const rect = element.getBoundingClientRect()
    const { source, component } = await sourceOf(win, element)
    handlers.onCommentClick({
      url: here(),
      clientX: event.clientX,
      clientY: event.clientY,
      target: { selector: selectorOf(element), text: textOf(element), source, component },
      position: {
        x: event.clientX + win.scrollX,
        y: event.clientY + win.scrollY,
        rx: rect.width ? (event.clientX - rect.left) / rect.width : 0,
        ry: rect.height ? (event.clientY - rect.top) / rect.height : 0,
      },
    })
  }
  const onKey = (event: KeyboardEvent) => {
    if (event.defaultPrevented) return
    if (event.key === "Escape") {
      // 화면 안의 창(대화 상자·메뉴)이 열려 있으면 Esc는 그 창 몫이다
      if (doc.querySelector('[role="dialog"], [role="alertdialog"], [role="menu"]')) return
      handlers.onEscape()
      return
    }
    if (isEditable(event.target) || event.metaKey || event.ctrlKey || event.altKey) return
    if (event.key === "c" || event.key === "C") handlers.onToggleComment()
    if (event.key === " ") {
      event.preventDefault()
      if (!event.repeat) handlers.onSpace(true)
    }
  }
  const onKeyUp = (event: KeyboardEvent) => {
    if (event.key === " ") handlers.onSpace(false)
  }
  const onWheel = (event: WheelEvent) => {
    if (!handlers.onWheel) return
    event.preventDefault()
    handlers.onWheel(event)
  }

  win.addEventListener("pointerdown", swallow, true)
  win.addEventListener("mousedown", swallow, true)
  win.addEventListener("click", onClick, true)
  win.addEventListener("keydown", onKey)
  win.addEventListener("keyup", onKeyUp)
  win.addEventListener("wheel", onWheel, { passive: false })

  return {
    setPins(next) {
      pins = next
      draw()
    },
    setCommentMode(on) {
      commentMode = on
      doc.querySelector(`style[${CURSOR_STYLE}]`)?.remove()
      if (on) {
        const style = doc.createElement("style")
        style.setAttribute(CURSOR_STYLE, "")
        style.textContent = `*{cursor:crosshair !important} [${PIN_LAYER}] *{cursor:pointer !important}`
        doc.head.appendChild(style)
      }
    },
    detach() {
      doc.querySelector(`style[${CURSOR_STYLE}]`)?.remove()
      win.clearInterval(timer)
      win.removeEventListener("pointerdown", swallow, true)
      win.removeEventListener("mousedown", swallow, true)
      win.removeEventListener("click", onClick, true)
      win.removeEventListener("keydown", onKey)
      win.removeEventListener("keyup", onKeyUp)
      win.removeEventListener("wheel", onWheel)
      layer.remove()
    },
  }
}
