import { GENERATED_SCREENS } from "./screens.generated"

// 목업 캔버스 목록 파일 — 캔버스에 띄울 화면의 목록.
// 기본 목록은 screens.generated.ts다 — `npm run canvas:list`가 mvp/feature-list.md 6절(화면 목록)·7절(상태 표)에서 만든다.
// 이 파일은 사람이(또는 AI가) 손으로 더하는 것만 적는다. 스크립트는 이 파일을 덮어쓰지 않는다.
//   · SCREEN_OVERRIDES — 자동 목록의 화면 하나를 화면 ID로 골라 칸을 바꾸거나 더한다(비교안 drafts, 흐름 묶음, 주소, 상태, 폰 폭만, 빼기).
//   · EXTRA_SCREENS — 화면 목록에 없지만 캔버스에 띄울 화면.
// 배열 순서가 곧 흐름 순서다(자동 목록은 화면 목록 표의 순서).

/** 같이 띄울 수 있는 상태 — 화면 주소 끝에 ?state=가 붙는다 (src/lib/dev-state.ts의 DEV_STATES와 같다) */
export type CanvasState = "empty" | "loading" | "error" | "forbidden"

export type CanvasScreen = {
  /** 화면 ID (화면 목록의 ID와 같게) */
  id: string
  /** 화면 이름 — 사용자가 보는 이름 */
  name: string
  /** 흐름 묶음 — 같은 묶음끼리 캔버스 왼쪽 목록에서 한 페이지로 고른다 (예: 「처음 온 사람: 둘러보기에서 가입까지」) */
  group: string
  /** 화면 주소 (예: "/posts") */
  path: string
  /** 같이 띄울 상태 */
  states?: CanvasState[]
  /** 띄울 폭 — 안 적으면 데스크톱·폰 둘 다. 휴대폰에서만 쓰는 화면은 ["phone"]으로 데스크톱 창을 뺀다(비교안·상태 창도 따른다) */
  widths?: ("desktop" | "phone")[]
  /** 비교안 — 같은 화면에 붙은 비교안들. 원래 화면 아래에 판마다 줄을 지어 놓인다.
   *  2단계 화면은 아직 states가 비어 있으니 보고 싶은 상태를 판마다 적는다(안 적으면 원래 화면과 같다 — 대개 상태 창 없음) */
  drafts?: { label: string; path: string; states?: CanvasState[] }[]
}

/** 자동 목록 위에 덮어쓸 칸 — 화면 ID로 고른다. skip: true면 캔버스에서 뺀다 */
export const SCREEN_OVERRIDES: Record<string, Partial<Omit<CanvasScreen, "id">> & { skip?: boolean }> = {
  // 비교안을 붙일 때 (화면 개선 단계):
  // "S-01": { drafts: [{ label: "A판", path: "/dev/drafts/home-a" }, { label: "B판", path: "/dev/drafts/home-b" }] },
  // 화면 목록에 흐름 묶음 칸이 없어 묶음을 손으로 정할 때:
  // "S-02": { group: "처음 온 사람: 둘러보기에서 가입까지" },
  // 휴대폰에서만 쓰는 화면 — 데스크톱 창을 빼고 폰 창만 띄운다(그림 찍기도 폰 폭만 찍는다):
  // "S-03": { widths: ["phone"] },
}

/** 화면 목록에 없지만 캔버스에 띄울 화면 — 자동 목록 뒤에 붙는다 */
export const EXTRA_SCREENS: CanvasScreen[] = []

export const SCREENS: CanvasScreen[] = [
  ...GENERATED_SCREENS.flatMap((screen) => {
    const { skip, ...change } = SCREEN_OVERRIDES[screen.id] ?? {}
    return skip ? [] : [{ ...screen, ...change }]
  }),
  ...EXTRA_SCREENS,
]
