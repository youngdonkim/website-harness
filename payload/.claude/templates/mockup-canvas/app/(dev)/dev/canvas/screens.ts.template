// 목업 캔버스 목록 파일 — 캔버스에 띄울 화면을 여기에 적는다.
// 기획 문서의 「화면 목록」과는 다르다: 화면 목록은 「어떤 화면이 있어야 하나」, 이 파일은 「캔버스가 어떤 주소를 띄울까」다.
// 화면을 만들 때 이 파일에도 한 줄 올린다. 배열 순서가 곧 흐름 순서다.

/** 같이 띄울 수 있는 상태 — 화면 주소 끝에 ?state=가 붙는다 (src/lib/dev-state.ts의 DEV_STATES와 같다) */
export type CanvasState = "empty" | "loading" | "error" | "forbidden"

export type CanvasScreen = {
  /** 화면 ID (화면 목록의 ID와 같게) */
  id: string
  /** 화면 이름 — 사용자가 보는 이름 */
  name: string
  /** 흐름 묶음 — 같은 묶음끼리 한 제목 아래 모인다 (예: 「처음 온 사람 — 둘러보기에서 가입까지」) */
  group: string
  /** 화면 주소 (예: "/posts") */
  path: string
  /** 같이 띄울 상태 */
  states?: CanvasState[]
  /** 비교안 — 같은 화면에 붙은 비교안들. 원래 화면 아래 「비교안」 제목 밑에 판마다 줄을 지어 뜬다.
   *  states를 빼면 원래 화면의 states와 같은 상태 창을 띄우고, 다르게 띄우려면 판마다 적는다 */
  drafts?: { label: string; path: string; states?: CanvasState[] }[]
}

